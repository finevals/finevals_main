# Only needed to preview the site locally. GitHub Pages builds this
# repo on its own (Pages build type "legacy"), so nothing here runs
# in production — see _config.yml.
#
#   bundle install
#   bundle exec jekyll serve
#
# Requires Ruby >= 2.7 (macOS system Ruby 2.6 is too old; use
# `brew install ruby` or rbenv).
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
